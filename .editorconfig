root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
end_of_line = crlf
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false

[*.{csproj,sln}]
end_of_line = crlf

[*.ps1]
charset = utf-8-bom
indent_size = 4
end_of_line = crlf

[*.asm]
trim_trailing_whitespace = false
insert_final_newline = false
